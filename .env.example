# Server-only secret. Never prefix with NEXT_PUBLIC_.
DECART_API_KEY=

# Comma-separated origins allowed to mint tokens in production (e.g. https://tryanything.app).
# In development the page's own origin (https://localhost:3000, https://<LAN-IP>:3000) is accepted automatically.
APP_ORIGINS=https://localhost:3000

# Optional tuning
DECART_MODEL=lucy-vton-latest
DECART_SCOPE_TOKEN_TO_MODEL=false
DECART_TOKEN_TTL_SECONDS=60
DECART_MAX_SESSION_SECONDS=180

# Public consent links
NEXT_PUBLIC_TERMS_URL=/legal/terms
NEXT_PUBLIC_PRIVACY_URL=/legal/privacy
NEXT_PUBLIC_AUP_URL=/legal/aup
