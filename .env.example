# Server-only secret from platform.decart.ai. Never prefix with NEXT_PUBLIC_. Use a separate key per environment.
DECART_API_KEY=

# Comma-separated origins allowed to call the paid APIs (e.g. https://tryanything.app).
# In development the page's own origin (https://localhost:3000, https://<LAN-IP>:3000) is accepted automatically.
APP_ORIGINS=https://localhost:3000

# Optional tuning (defaults shown). Model names are validated against the installed SDK at startup.
DECART_MODEL=lucy-vton-latest
DECART_IMAGE_MODEL=lucy-image-2
DECART_SCOPE_TOKEN_TO_MODEL=false
DECART_TOKEN_TTL_SECONDS=60
DECART_MAX_SESSION_SECONDS=180
